# LabSphere AI Environment Configuration Guide
#
# Frontend Environment (.env in /Frontend):
# EXPO_PUBLIC_API_URL=https://your-backend-service.onrender.com
#
# Backend Environment (.env in /Backend):
# SECRET_KEY=your-production-secret-key-32-chars
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/labsphere?retryWrites=true&w=majority
# FRONTEND_URL=https://your-frontend.vercel.app
# PORT=5050
