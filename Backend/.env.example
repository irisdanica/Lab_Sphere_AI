# LabSphere AI Backend Environment Configuration

# Flask Production Secret Key (Generate a random 32+ char string in production)
SECRET_KEY=your-production-secret-key-here

# Hosted MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/labsphere?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/labsphere

# Allowed Frontend URL for CORS (e.g., https://labsphere-ai.vercel.app or * for all)
FRONTEND_URL=*

# Server Port (assigned automatically by Render, Railway, Heroku)
PORT=5050
